# Supabase (Settings > API no painel do projeto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponha no client — ignora RLS. Usada só em rotas de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Z-API (instância de WhatsApp)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
# Client-Token de "Segurança da conta" (nível de conta, não da instância)
ZAPI_CLIENT_TOKEN=
# Valor aleatório usado na URL do webhook de mensagem recebida (ex: openssl rand -hex 32)
ZAPI_WEBHOOK_SECRET=

# Cron diário de disparo (/api/cron/dispatch-reminders)
# Valor aleatório, diferente do ZAPI_WEBHOOK_SECRET (ex: openssl rand -hex 32)
CRON_SECRET=
